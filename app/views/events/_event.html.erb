<li class="ev-item">
  <span class="ev-node" aria-hidden="true">
    <%= icon(:bolt, size: 14) %>
  </span>
  <div class="ev-body">
    <div class="ev-meta">
      <time class="ev-date" datetime="<%= event.event_date.iso8601 %>"><%= fmt_date_full(event.event_date) %></time>
    </div>

    <h3 class="ev-title"><%= event.title %></h3>

    <% if event.note.present? %>
      <p class="ev-note"><%= event.note %></p>
    <% end %>

    <% if event.so_what.present? %>
      <p class="ev-sowhat"><%= event.so_what %></p>
    <% end %>

    <% if event.citations.present? %>
      <div class="ev-cites">
        <span class="ev-cites-label">Sources</span>
        <% event.citations.each do |citation| %>
          <% if (href = external_href(citation["url"])) %>
            <%= link_to citation_host(href), href, class: "ev-cite",
                  title: citation["title"].presence, target: "_blank", rel: "noopener" %>
          <% end %>
        <% end %>
      </div>
    <% elsif event.source_url.present? %>
      <%= link_to event.source_url, class: "ev-source", target: "_blank", rel: "noopener" do %>
        Source <%= icon(:external, size: 13) %>
      <% end %>
    <% end %>
  </div>
</li>
